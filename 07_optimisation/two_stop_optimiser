# two stop optimiser

def optimise_two_stop():

    compounds = [
        "soft",
        "medium",
        "hard"
    ]

    best_time = float("inf")
    best_strategy = None

    results = []

    
    # search tyre compound combinations

    for compound_1 in compounds:

        for compound_2 in compounds:

            for compound_3 in compounds:

                # compound use rule
                # At least two different compounds
                # must be used during the race.
                # This excludes strategies such as:
                # Soft -> Soft -> Soft
                # Medium -> Medium -> Medium
                # Hard -> Hard -> Hard

                unique_compounds = {
                    compound_1,
                    compound_2,
                    compound_3
                }

                if len(unique_compounds) < 2:
                    continue

                # search first pit stop lap

                for pit_1 in range(
                    5,
                    race_laps - 10
                ):

                    # search second pit stop lap
                    # Second stop must occur at least
                    # five laps after the first stop.

                    for pit_2 in range(
                        pit_1 + 5,
                        race_laps - 4
                    ):

                        race_time = (
                            simulate_two_stop_strategy(
                                compound_1,
                                compound_2,
                                compound_3,
                                pit_1,
                                pit_2
                            )
                        )

                        result = {

                            "compound_1":
                                compound_1,

                            "compound_2":
                                compound_2,

                            "compound_3":
                                compound_3,

                            "pit_1":
                                pit_1,

                            "pit_2":
                                pit_2,

                            "race_time":
                                race_time
                        }

                        results.append(
                            result
                        )

                        # check for new best strategy

                        if race_time < best_time:

                            best_time = race_time
                            best_strategy = result

    return (
        best_strategy,
        results
    )

# run optimisation

best_strategy, results = (
    optimise_two_stop()
)


# display best result
# rank two stop strategies

sorted_results = sorted(
    results,
    key=lambda result: result["race_time"]
)


